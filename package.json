{
  "name": "promptrails",
  "displayName": "PromptRails",
  "description": "Run agents, test prompts, query data sources, and manage versions — all from VS Code.",
  "version": "0.2.1",
  "publisher": "promptrails",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/promptrails/vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "agents",
    "llm",
    "prompts",
    "promptrails"
  ],
  "icon": "media/promptrails-icon.png",
  "activationEvents": [
    "onCommand:promptrails.openPanel",
    "onCommand:promptrails.setApiKey"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "promptrails.openPanel",
        "title": "PromptRails: Open Dashboard",
        "icon": {
          "light": "media/promptrails-icon.svg",
          "dark": "media/promptrails-icon.svg"
        }
      },
      {
        "command": "promptrails.setApiKey",
        "title": "PromptRails: Set API Key"
      },
      {
        "command": "promptrails.clearApiKey",
        "title": "PromptRails: Clear API Key"
      }
    ],
    "configuration": {
      "title": "PromptRails",
      "properties": {
        "promptrails.apiUrl": {
          "type": "string",
          "default": "https://api.promptrails.ai",
          "description": "PromptRails API base URL"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptrails",
          "title": "PromptRails",
          "icon": "media/promptrails-icon.svg"
        }
      ]
    },
    "views": {
      "promptrails": [
        {
          "id": "promptrails.welcome",
          "name": "Dashboard"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "promptrails.welcome",
        "contents": "Open the PromptRails dashboard to manage your agents, prompts, and data sources.\n[Open Dashboard](command:promptrails.openPanel)"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js && node esbuild.webview.js",
    "compile:host": "node esbuild.js",
    "compile:webview": "node esbuild.webview.js",
    "watch": "concurrently \"node esbuild.js --watch\" \"node esbuild.webview.js --watch\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src/ webview/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.ts\" \"webview/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"webview/**/*.{ts,tsx,css}\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.85.0",
    "@types/vscode-webview": "^1.57.4",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vscode/vsce": "^2.22.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.12",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.33",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@promptrails/sdk": "^0.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
